# ─── LLM Provider ──────────────────────────────────────────────────────────────
# Default: Ollama (local, free, no API key required).
# Change LLM_PROVIDER and the *_MODEL vars to switch providers.
#
# Supported values: ollama | anthropic | openai | gemini | groq | mistral | together
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434   # Ollama API endpoint

# ─── Provider API Keys ─────────────────────────────────────────────────────────
# Set only the key(s) for the provider(s) you actually use.

# Anthropic  →  https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI  →  https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini  →  https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Groq  →  https://console.groq.com/keys
GROQ_API_KEY=

# Mistral  →  https://console.mistral.ai/
MISTRAL_API_KEY=

# Together AI  →  https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY=

# ─── Agent Models ──────────────────────────────────────────────────────────────
# Use provider-prefixed model IDs.  Examples:
#
#   Ollama (local)  : ollama/llama3.2  |  ollama/mistral  |  ollama/qwen2.5
#   Anthropic       : anthropic/claude-sonnet-4-6  |  anthropic/claude-opus-4-7
#   OpenAI          : openai/gpt-4o  |  openai/gpt-4o-mini
#   Gemini          : gemini/gemini-1.5-flash  |  gemini/gemini-1.5-pro
#   Groq            : groq/llama-3.3-70b-versatile  |  groq/mixtral-8x7b-32768
#   Mistral         : mistral/mistral-large-latest  |  mistral/mistral-small-latest
#   Together AI     : together_ai/meta-llama/Llama-3-70b-chat-hf
#
MARKET_DATA_AGENT_MODEL=ollama/llama3.2
SENTIMENT_AGENT_MODEL=ollama/llama3.2
RISK_AGENT_MODEL=ollama/llama3.2
# For vision analysis use a vision-capable model (e.g. ollama/llava, openai/gpt-4o).
# Falls back to text-description mode automatically for non-vision models.
CHART_VISION_MODEL=ollama/llama3.2

# ─── Scanner Agent ─────────────────────────────────────────────────────────────
# How often to scan each watchlist ticker (seconds)
SCANNER_INTERVAL_SECONDS=60
# Combined signal score threshold to trigger full LLM analysis (0.0-1.0)
SCANNER_SIGNAL_THRESHOLD=0.4

# ─── Market Data APIs ──────────────────────────────────────────────────────────
# yfinance works out-of-the-box (no key). These are optional enhancements.
ALPHA_VANTAGE_API_KEY=   # https://www.alphavantage.co/support/#api-key
POLYGON_API_KEY=         # https://polygon.io/dashboard/api-keys

# ─── Social / News ─────────────────────────────────────────────────────────────
# All optional — agents fall back gracefully when these are absent.
REDDIT_CLIENT_ID=        # https://www.reddit.com/prefs/apps  (script app)
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=FinancialIntelligenceHub/1.0
NEWS_API_KEY=            # https://newsapi.org/register

# ─── Infrastructure ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
POSTGRES_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fintelligence

# ─── Application ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=development
MAX_ANALYSIS_TIMEOUT_SECONDS=120

# ─── Frontend Localization ─────────────────────────────────────────────────────
# Default UI language (baked into the frontend at build time via Vite).
# Users can override this at runtime via the language selector in the app header.
# Supported: es | en | pt | fr | de | zh | ja
VITE_DEFAULT_LANG=es
